# Copy to .env (git-ignored) and set your own values. Docker Compose reads it automatically.
POSTGRES_PASSWORD=change-me
# Only needed for the sso profile (docker compose --profile sso up -d keycloak)
KEYCLOAK_ADMIN_PASSWORD=change-me
# Local object storage (SeaweedFS S3 gateway). Any S3-compatible store works; these are its access keys.
S3_ROOT_ACCESS_KEY=audit
S3_ROOT_SECRET_KEY=change-me-please
