# Copy to backend/.env for local development (never used when NODE_ENV=production).
# use the POSTGRES_PASSWORD from the root .env
DATABASE_URL=postgres://audit:change-me@localhost:5432/audit
PORT=3002
# Database TLS: disable | require | verify-full (default verify-full in production, where disable is refused).
# Put TLS in DATABASE_SSL, never in the URL (sslmode=, ssl=, sslcert= and the other TLS parameters are refused). Optional CA bundle: DATABASE_SSL_CA_FILE=/path/ca.pem
# DATABASE_SSL=disable
# fatal | error | warn | info (default) | debug | trace | silent
# LOG_LEVEL=info
# Proxies in front of the API whose X-Forwarded-For / X-Request-Id are trusted (Compose's nginx = 1)
# TRUST_PROXY=0
# Bearer token Prometheus sends to /metrics (at least 24 characters; required in production)
# METRICS_TOKEN=
# Any secret may instead be read from a file: DATABASE_URL_FILE, OIDC_CLIENT_SECRET_FILE, S3_ACCESS_KEY_ID_FILE,
# S3_SECRET_ACCESS_KEY_FILE, AZURE_STORAGE_CONNECTION_STRING_FILE, ANTHROPIC_API_KEY_FILE, METRICS_TOKEN_FILE, API_DB_PASSWORD_FILE
# offline (default, no key needed) | anthropic
LLM_PROVIDER=offline
# ANTHROPIC_API_KEY=

# ---- Agent runs (npm run worker runs them) ----
# These five must be the same for the API and the worker (Compose passes them to both)
# Kill switch: false refuses new runs, and the worker leases nothing
# AGENT_ENABLED=true
# A run's budget ceiling (a starter may lower it; an audit manager may raise it later)
# AGENT_MAX_STEPS=200
# AGENT_MAX_TOKENS=2000000
# AGENT_MAX_COST_USD=25
# QA score a workpaper should reach before its gate (0-100)
# AGENT_QA_THRESHOLD=70
# Worker only: probes and metrics port, polling interval, loops per worker
# WORKER_PORT=3003
# AGENT_POLL_MS=3000
# AGENT_WORKER_CONCURRENCY=2
# Worker only: models per agent role, and price overrides (JSON, USD per million tokens)
# AGENT_POLICY_MODEL=claude-sonnet-5-5
# AGENT_QA_MODEL=claude-opus-5-5
# AGENT_TEST_PLAN_MODEL=claude-sonnet-5-5
# AGENT_MODEL_TIMEOUT_MS=120000
# AGENT_MODEL_PRICES={"claude-opus-5-5":{"inputPerMTok":4,"outputPerMTok":20}}
# ASSISTANT_ENABLED=true
# ASSISTANT_MODEL=claude-sonnet-5-5
# ASSISTANT_MODEL_TIMEOUT_MS=20000

# ---- Sign-in ----
# Demo users (development only; the server refuses DEV_AUTH=true with NODE_ENV=production)
DEV_AUTH=true
PUBLIC_URL=http://localhost:5174
# SESSION_IDLE_MINUTES=30
# SESSION_MAX_HOURS=12

# Real sign-in through an OpenID Connect provider (Entra ID, Okta, Keycloak, …).
# With the local Keycloak (docker compose --profile sso up -d keycloak):
# OIDC_ISSUER=http://localhost:8081/realms/audit
# OIDC_CLIENT_ID=audit-platform
# OIDC_CLIENT_SECRET=audit-dev-secret
# OIDC_REDIRECT_URI=http://localhost:5174/auth/callback
# OIDC_GROUPS_CLAIM=groups
# OIDC_SCOPES=openid profile email
#   Okta: add the groups scope (e.g. "openid profile email groups") and a groups claim on the authorization server.
# OIDC_ROLE_MAP={"audit-auditors":"auditor","audit-managers":"audit_manager","audit-cae":"cae","audit-admins":"admin","audit-viewers":"viewer"}

# ---- File storage ----
# local (development only) | s3 | azure
BLOB_DRIVER=local
# BLOB_LOCAL_DIR=./data/blobs
# BLOB_MAX_BYTES=26214400
# Hand out presigned download links instead of streaming through the API (only if browsers can reach the storage endpoint)
# BLOB_PRESIGN_DOWNLOADS=false
# S3 / S3-compatible (SeaweedFS, MinIO...):   BLOB_DRIVER=s3, S3_BUCKET, S3_REGION, S3_ENDPOINT (non-AWS only), S3_FORCE_PATH_STYLE=true (non-AWS), S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY (omit on AWS to use the instance role)
#   S3 permissions needed: s3:GetObject, s3:PutObject, s3:ListBucket (without ListBucket a missing object is a 403, read as a storage failure)
#   S3_CONDITIONAL_WRITES=true (default; puts send If-None-Match: *). Set false only for services that ignore it (SeaweedFS 3.80).
#   In production S3_ENDPOINT must be https:// and BLOB_MAX_BYTES at most 104857600 (100 MiB).
# Azure Blob:   BLOB_DRIVER=azure, AZURE_STORAGE_CONNECTION_STRING, AZURE_STORAGE_CONTAINER=evidence
#   (the Azurite emulator account is refused in production)

# ---- Knowledge trust rules (spec §6.4) ----
# Until a domain expert verifies the content packs, findings may
# cite unverified knowledge only when this is true; it is then flagged, not blocked. Refused in production.
ALLOW_UNVERIFIED_CITATIONS=true

# ---- Evidence extraction (spec 2026-10-22-evidence-management §10) ----
# Largest file the server will extract text from, in bytes (default: BLOB_MAX_BYTES).
# EXTRACT_MAX_BYTES=26214400
# How long a registration waits for an extractor before the document is marked failed.
# EXTRACT_TIMEOUT_MS=30000
# A docx/xlsx whose entries would inflate past this many bytes is refused before parsing (256 MiB).
# ZIP_MAX_UNCOMPRESSED_BYTES=268435456
# Default retention for new evidence, in years; unset applies none.
# EVIDENCE_RETENTION_YEARS=
