{
  "name": "audit-platform-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Audit & Controls Agent Platform - engine, content packs and API (MVP)",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "migrate": "tsx src/db/cli.ts migrate",
    "import-json": "tsx src/db/cli.ts import-json",
    "verify": "tsx src/db/cli.ts verify",
    "packs:compile": "tsx src/knowledge/packs-cli.ts compile",
    "packs:migrate": "tsx src/knowledge/packs-cli.ts migrate",
    "eval": "tsx src/eval/cli.ts",
    "traceability": "tsx src/validation/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@azure/storage-blob": "^12.34.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "kysely": "^0.29.6",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jose": "^6.2.12",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
